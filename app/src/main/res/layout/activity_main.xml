<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:text="Konfigurator pizzy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="35sp"
            android:textStyle="bold"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"/>

        <TextView
            android:text="Autor: Paweł"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:layout_marginLeft="20dp"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="30dp">

            <TextView
                android:text="Wybierz rozmiar:"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <RadioGroup
                android:id="@+id/rozmiary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/mala"
                android:text="Mała 25zł"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <RadioButton
                android:id="@+id/srednia"
                android:text="Średnia 35zł"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/duza"
                android:text="Duża 45zł"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            </RadioGroup>

        </LinearLayout>

        <CheckBox
            android:id="@+id/grubeCiasto"
            android:text="Grube ciasto (+5zł)"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:rowCount="4"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp">

            <TextView
                android:text="Liczba sztuk:"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_columnWeight="2"
                android:textSize="20sp"/>

            <EditText
                android:id="@+id/liczbaSztuk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:layout_columnWeight="2"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:text="1">
            </EditText>

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="+"
                android:layout_columnWeight="1"
                android:onClick="dodaj">

            </Button>

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="-"
                android:layout_columnWeight="1"
                android:onClick="odejmij">
            </Button>


        </GridLayout>

        <Button
            android:onClick="podsumowanie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Przejdź do podsumowania"
            android:layout_margin="20dp">
        </Button>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>